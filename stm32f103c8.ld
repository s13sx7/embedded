/* Определяем точку входа — с какой функции начинать выполнение */
ENTRY(Reset_Handler)

/* Описываем физическую память микроконтроллера    */
MEMORY
{
    FLASH (rx)  : ORIGIN = 0x08000000, LENGTH = 64K
    RAM (rwx)   : ORIGIN = 0x20000000, LENGTH = 20K
}

/* Указатель на вершину стека (конец оперативной памяти) */
_estack = ORIGIN(RAM) + LENGTH(RAM);

/* Описываем, как раскладывать части программы по памяти */
SECTIONS
{
    /* 1. Векторная таблица прерываний. Должна быть в самом начале Flash! */
    .isr_vector :
    {
        . = ALIGN(4);
        KEEP(*(.isr_vector))
        . = ALIGN(4);
    } > FLASH

    /* 2. Сам код программы и константы */
    .text :
    {
        . = ALIGN(4);
        *(.text*)
        *(.rodata*)
        . = ALIGN(4);
        _etext = .; /* Конец кода во Flash */
    } > FLASH

    /* 3. Инициализированные переменные. 
       Они хранятся во Flash, но при старте будут скопированы в RAM */
    .data :
    {
        . = ALIGN(4);
        _sdata = .; /* Начало секции data в RAM */
        *(.data*)
        . = ALIGN(4);
        _edata = .; /* Конец секции data в RAM */
    } > RAM AT > FLASH

    /* Адрес, откуда брать начальные значения для .data во Flash */
    _sidata = LOADADDR(.data);

    /* 4. Неинициализированные переменные. 
       Они занимают место только в RAM. При старте будут обнулены. */
    .bss :
    {
        . = ALIGN(4);
        _sbss = .;
        *(.bss*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = .;
    } > RAM
}
